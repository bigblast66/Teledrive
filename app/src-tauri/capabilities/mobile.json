{
  "identifier": "mobile-only",
  "description": "Permissions required only on Android",
  "platforms": [
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "fs:allow-read",
      "allow": [
        { "path": "$APPCACHE/**" },
        { "path": "$APPDATA/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        { "path": "$APPCACHE/**" },
        { "path": "$APPDATA/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "opener:allow-open-path",
    "shell:allow-open"
  ]
}
