{
  "$schema": "https://schema.tauri.app/config/2",
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        
      ],
      "pubkey": ""
    }
  },
  "productName": "Telegram Drive",
  "version": "1.9.9",
  "identifier": "com.bigblast66.telegramdrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Telegram Drive",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* https://asset.localhost http://asset.localhost; media-src 'self' blob: data: asset: https: https://asset.localhost http://asset.localhost http://localhost:* http://127.0.0.1:*; img-src 'self' data: blob: asset: https: https://asset.localhost http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https:; frame-src 'self' blob: https: http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPDATA/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$PICTURE/**",
          "$DESKTOP/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "$CACHE/**",
          "$TEMP/**",
          "**"
        ]
      },
      "capabilities": [
        "default",
        "mobile-only"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
